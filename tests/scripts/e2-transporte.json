[
  {"op": "log", "text": "E2 transporte: velocidades 1×/2×/3×/4×/8×, pausa, seek, frame step, loop IN/OUT y política de audio"},
  {"op": "wait", "ms": 500},
  {"op": "import", "path": "${WORKSPACE}/tests/fixtures/media/fixture-a.mp4"},
  {"op": "insert", "asset": 0, "at": 0.0},
  {"op": "action", "id": "view.fit"},
  {"op": "seek", "t": 0.0},
  {"op": "wait_frame"},
  {"op": "play"},
  {"op": "wait", "ms": 1500},
  {"op": "assert", "playing": true, "rate": 1.0, "position": [1.2, 1.9]},
  {"op": "rate", "value": 3.0},
  {"op": "wait", "ms": 1000},
  {"op": "assert", "playing": true, "rate": 3.0, "position": [3.8, 5.5]},
  {"op": "rate", "value": 4.0},
  {"op": "wait", "ms": 1000},
  {"op": "assert", "playing": true, "rate": 4.0, "position": [7.5, 10.0]},
  {"op": "pause"},
  {"op": "wait", "ms": 200},
  {"op": "assert", "playing": false},
  {"op": "dump", "path": "${OUTPUT}/transporte-01-pausa-tras-4x.json"},
  {"op": "seek", "t": 1.0},
  {"op": "wait_frame"},
  {"op": "action", "id": "transport.skim"},
  {"op": "wait", "ms": 800},
  {"op": "assert", "playing": true, "rate": 8.0, "position": [6.0, 8.5]},
  {"op": "screenshot", "path": "${OUTPUT}/transporte-02-skim-8x.png"},
  {"op": "pause"},
  {"op": "rate", "value": 1.0},
  {"op": "seek", "t": 2.0},
  {"op": "wait_frame"},
  {"op": "step_frames", "frames": 1},
  {"op": "wait", "ms": 400},
  {"op": "assert", "playing": false, "position": [2.0333, 2.0334]},
  {"op": "step_frames", "frames": -10},
  {"op": "wait", "ms": 400},
  {"op": "assert", "playing": false, "position": [1.6999, 1.7001]},
  {"op": "dump", "path": "${OUTPUT}/transporte-03-frame-step.json"},
  {"op": "set_loop", "start": 2.0, "end": 3.0},
  {"op": "seek", "t": 2.0},
  {"op": "wait_frame"},
  {"op": "play"},
  {"op": "wait", "ms": 2500},
  {"op": "assert", "playing": true, "position": [2.0, 3.05]},
  {"op": "wait", "ms": 1200},
  {"op": "assert", "playing": true, "position": [2.0, 3.05]},
  {"op": "screenshot", "path": "${OUTPUT}/transporte-04-loop.png"},
  {"op": "pause"},
  {"op": "clear_loop"},
  {"op": "seek", "t": 11.5},
  {"op": "wait_frame"},
  {"op": "play"},
  {"op": "wait", "ms": 1200},
  {"op": "assert", "playing": false, "position": [11.9, 12.0]},
  {"op": "log", "text": "al llegar al final la reproducción se detiene en la duración de la secuencia"},
  {"op": "dump", "path": "${OUTPUT}/transporte-05-final.json"},
  {"op": "quit"}
]
